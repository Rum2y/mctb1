# Copy this file to .env.local and fill in your values.
# Never commit .env.local or share it in chat.

# --- Twilio (from console.twilio.com) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number you bought, in +1XXXXXXXXXX format
TWILIO_PHONE_NUMBER=

# Leave empty to run in "dry run" mode: texts are saved to the dashboard
# but not actually sent. Set to "false" to skip Twilio signature checks
# (only for local testing, never in production).
TWILIO_VALIDATE_SIGNATURE=true

# --- Your app ---
# Public address of the deployed app, no trailing slash.
# Twilio signatures and tracked links depend on this being exact.
PUBLIC_BASE_URL=http://localhost:3000

# Password for the dashboard, and a long random string used to sign the login cookie.
DASHBOARD_PASSWORD=
SESSION_SECRET=

# --- Database ---
# Leave empty to use a local file database in ./.data (fine for testing).
# For production, paste your Supabase connection string (Transaction pooler, port 6543).
DATABASE_URL=

# --- The business (defaults; you can change these later in the dashboard Settings) ---
BUSINESS_NAME=
# Where owner alerts go: the owner's cell, +1XXXXXXXXXX
OWNER_PHONE=
BOOKING_URL=

# How calls reach Twilio:
#   forward = the business's carrier forwards unanswered calls to Twilio (recommended)
#   dial    = Twilio is the public number; it rings OWNER_PHONE first, then texts back if unanswered
CALL_MODE=forward
